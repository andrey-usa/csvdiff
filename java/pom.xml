<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.csvdiff</groupId>
  <artifactId>csvdiff</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>csvdiff</name>
  <description>Parameterised composite-key CSV comparison with a self-contained HTML report</description>

  <properties>
    <maven.compiler.release>26</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <duckdb.version>1.5.5.1</duckdb.version>
    <tablesaw.version>0.44.4</tablesaw.version>
    <fastcsv.version>4.4.0</fastcsv.version>
    <jackson.version>2.22.2</jackson.version>
    <tomlj.version>1.1.1</tomlj.version>
    <junit.version>6.1.3</junit.version>

    <compiler.plugin.version>3.16.0</compiler.plugin.version>
    <surefire.plugin.version>3.5.6</surefire.plugin.version>
    <shade.plugin.version>3.6.2</shade.plugin.version>
  </properties>

  <dependencies>
    <!-- Engine: DuckDB, out-of-core, the default. -->
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <version>${duckdb.version}</version>
    </dependency>

    <!-- Engine: Tablesaw, in-memory columnar dataframe. -->
    <dependency>
      <groupId>tech.tablesaw</groupId>
      <artifactId>tablesaw-core</artifactId>
      <version>${tablesaw.version}</version>
    </dependency>

    <!-- Engine: native, backed by FastCSV for parsing only. -->
    <dependency>
      <groupId>de.siegmar</groupId>
      <artifactId>fastcsv</artifactId>
      <version>${fastcsv.version}</version>
    </dependency>

    <!-- Result contract serialisation. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- csvdiff.toml profiles. -->
    <dependency>
      <groupId>org.tomlj</groupId>
      <artifactId>tomlj</artifactId>
      <version>${tomlj.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>csvdiff</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler.plugin.version}</version>
        <configuration>
          <compilerArgs>
            <!-- Warnings are defects. `this-escape` fires inside generated
                 record accessors on some JDKs, and `processing` fires when no
                 annotation processor is configured, so both stay off. -->
            <arg>-Xlint:all,-this-escape,-processing</arg>
            <arg>-Werror</arg>
            <!-- The Vector API is still an incubator module. The three fast engines are the
                 only code that touches it, and they check at runtime whether it loaded. -->
            <arg>--add-modules</arg>
            <arg>jdk.incubator.vector</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.plugin.version}</version>
        <configuration>
          <!-- Incubator modules are opt-in at run time as well as at compile time. -->
          <argLine>--add-modules jdk.incubator.vector</argLine>
        </configuration>
      </plugin>

      <!-- One runnable jar: `java -jar target/csvdiff.jar compare a.csv b.csv -k id`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade.plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.csvdiff.Cli</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
