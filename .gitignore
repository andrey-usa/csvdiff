__pycache__/
*.pyc
/build/
/dist/
# Generated data and benchmark output, anchored per implementation. Unanchored,
# "bench/" would also match a source package named bench (the Java port has one)
# and silently drop it from every commit.
/data/
/bench/
/out/
/go/data/
/go/bench/
/go/out/
/rust/data/
/rust/bench/
/rust/out/
/rust/target/
csvdiff.toml
*.html
!examples/report.html
!java/src/main/resources/**/*.html
!go/internal/csvdiff/report.html
!rust/src/report.html
.claude/settings.local.json

# JVM crash dumps, left behind when an engine is run out of memory on purpose.
hs_err_pid*.log
replay_pid*.log

# C++ build output.
/cpp/build/

# Zig build output.
/zig/zig-out/
/zig/.zig-cache/

# C build output.
/c/csvdiff
/c/gen-data
/c/csvdiff-asan

# The C port builds objects beside its sources now, not just one binary.
c/*.o
